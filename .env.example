# Database (optional — defaults to backend/data/zomato.db)
# DATABASE_URL=sqlite:///D:/path/to/backend/data/zomato.db

# Groq LLM (Phase 3)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=groq/compound-mini

# Hugging Face dataset
HF_DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation
EXPECTED_ROW_COUNT=51717

# Frontend (Vercel) — set to your public backend URL, no trailing slash
# VITE_API_URL=https://your-api.onrender.com

# Phase 5 — Production
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
API_KEY=
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
